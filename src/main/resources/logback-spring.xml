<?xml version="1.0" encoding="UTF-8"?>
<!-- stdout is reserved for command output and MCP JSON-RPC, so logs go to stderr (warnings and up) and to the log file. -->
<configuration>
  <springProperty name="LOG_FILE" source="phoenix.log-file" defaultValue="${java.io.tmpdir}/phoenix.log"/>

  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>WARN</level>
    </filter>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_FILE}</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
      <maxFileSize>5MB</maxFileSize>
      <maxHistory>14</maxHistory>
      <totalSizeCap>50MB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{30} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="WARN">
    <appender-ref ref="STDERR"/>
    <appender-ref ref="FILE"/>
  </root>
  <logger name="dev.phoenix" level="INFO"/>
</configuration>
